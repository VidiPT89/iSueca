/* Rules */
"rules.title" = "Rules";

"rules.section.overview.title" = "Overview";
"rules.section.overview.body" = "Sueca is played by 4 players in 2 partnerships, seated across from each other. A 40-card deck is used, with the 8, 9 and 10 removed from each suit. The partnership with the most points after 10 tricks wins the hand.";

"rules.section.values.title" = "Card Values & Strength";
"rules.section.values.body" = "From strongest to weakest: Ace (11 points), 7 (10 points), King (4 points), Jack (3 points), Queen (2 points), then 6, 5, 4, 3, 2 (0 points each). The deck totals 120 points.";

"rules.section.dealing.title" = "Dealing & Trump";
"rules.section.dealing.body" = "Each player receives 10 cards. The dealer's last card is revealed as the trump suit for the hand. The dealer rotates after every hand.";

"rules.section.play.title" = "Playing a Trick";
"rules.section.play.body" = "You must follow the suit that was led if you can. If you have none, you must play a trump if you have one; otherwise you may discard any card. The highest trump played wins the trick, or if no trump was played, the highest card of the led suit wins.";

"rules.section.winning.title" = "Winning the Hand";
"rules.section.winning.body" = "After all 10 tricks are played, the partnership with more than 60 of the 120 points wins the hand. Winning every trick for all 120 points is called a Sueca.";

