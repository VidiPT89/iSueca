/* Rules */
"rules.title" = "Regras";

"rules.section.overview.title" = "Visão Geral";
"rules.section.overview.body" = "A Sueca joga-se a 4, em 2 equipas de parceiros sentados em posições opostas. Usa-se um baralho de 40 cartas, sem os 8, 9 e 10 de cada naipe. A equipa que somar mais pontos ao fim de 10 vazas ganha a mão.";

"rules.section.values.title" = "Valor e Força das Cartas";
"rules.section.values.body" = "Da mais forte à mais fraca: Ás (11 pontos), 7 (10 pontos), Rei (4 pontos), Valete (3 pontos), Dama (2 pontos), seguidos de 6, 5, 4, 3 e 2 (0 pontos cada). O baralho totaliza 120 pontos.";

"rules.section.dealing.title" = "Distribuição e Trunfo";
"rules.section.dealing.body" = "Cada jogador recebe 10 cartas. A última carta do dador é revelada e define o naipe de trunfo dessa mão. O dador roda a cada mão.";

"rules.section.play.title" = "Jogar uma Vaza";
"rules.section.play.body" = "É obrigatório seguir o naipe jogado, se tiveres cartas desse naipe. Se não tiveres, és obrigado a jogar trunfo, caso tenhas; caso contrário, podes descartar qualquer carta. Ganha o trunfo mais alto jogado, ou, se ninguém jogou trunfo, a carta mais alta do naipe de saída.";

"rules.section.winning.title" = "Ganhar a Mão";
"rules.section.winning.body" = "Depois de jogadas as 10 vazas, a equipa que somar mais de 60 dos 120 pontos ganha a mão. Ganhar todas as vazas e os 120 pontos chama-se fazer uma Sueca.";

